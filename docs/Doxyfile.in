# Doxygen configuration for BEAST
# Battery Estimation Architecture and Simulation Toolkit

PROJECT_NAME           = "BEAST"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "Battery Estimation Architecture and Simulation Toolkit"

OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/docs"
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English

INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/include" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/src" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/apps" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/mainpage.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/USAGE.md"
RECURSIVE              = YES
FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.c \
                         *.cpp \
                         *.md
EXCLUDE_PATTERNS       = */build/* \
                         */.git/*

USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/docs/mainpage.md"
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_FROM_PATH        = "@CMAKE_CURRENT_SOURCE_DIR@"
FULL_PATH_NAMES        = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO

HAVE_DOT               = NO
CLASS_DIAGRAMS         = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO

JAVADOC_AUTOBRIEF      = NO
MULTILINE_CPP_IS_BRIEF = NO
